/* secrets.h.example — DrainIntel sensor credentials template.
 *
 * SETUP (do this once):
 *   1. Make a copy of this file in the SAME folder.
 *   2. Rename the copy to exactly:  secrets.h
 *   3. Fill in the three values below.
 *
 * secrets.h is git-ignored — your Wi-Fi password never goes to GitHub.
 * Do NOT rename or delete this .example file; it is the shared template.
 */
#ifndef SECRETS_H
#define SECRETS_H

// 2.4 GHz Wi-Fi the board will join.
// A phone hotspot works. NOT 5 GHz, NOT university eduroam.
#define WIFI_SSID      "YOUR_WIFI_NAME"
#define WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// Leave "" unless the server has an INGEST_API_KEY set — then paste the
// SAME value here so the board's readings are accepted.
#define API_KEY        ""

#endif  // SECRETS_H
